# Copy to config.env and edit. Both nodes should use the same versions.
USERS="admin user1 user2 user3 user4"
ADMIN_USER=admin
SET_PASSWORDS=0
DRIVER_BRANCH=580
CONDA_ROOT=/opt/conda
NVM_ROOT=/opt/nvm
NVM_VERSION=v0.40.3
NODE_VERSION=--lts
AGENTS_ROOT=/opt/gpu-agents
CODEX_VERSION=latest
PI_PACKAGE=@earendil-works/pi-coding-agent
PI_VERSION=latest
PYTHON_VERSION=3.11
TORCH_VERSION=2.10.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
APT_SOURCE=keep
RESTORE_APT_SOURCE=1
# Optional internal mirror hostnames to access directly, separated by spaces.
APT_DIRECT_HOSTS=""
# Optional extra no_proxy entries, separated by commas.
NO_PROXY_EXTRA=""
# Only used when module 5 / 6 is explicitly selected.
SSH_KEYS_DIR=/root/gpu-public-keys
PROXY_URL=http://127.0.0.1:18888
# Set PROXY_SERVER to install the remote server and this node's tunnel (module 6).
# When set, this takes precedence over PROXY_URL; Node 1 root SSH access required.
PROXY_SERVER=""
PROXY_SERVER_ADDRESS="" # optional: real address reachable from tunnel user
PROXY_CLIENT_IP="" # required for tunnel installation; use this node's actual IP
PROXY_PORT=18888
PROXY_LOCAL_PORT=18888
